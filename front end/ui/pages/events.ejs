

















<%###################################################
#                                                   #
#           Modal Pop-Up to Add New Event           #
#                                                   #
###################################################%>

<%# Calvin - Added modal pop-up for adding new events %>
<div id = "addEventModal" class = "modal">
    <div class = "modal-content">
        <form id = "addEventForm">
            <label>Event Name:</label>
            <input type = "text" id = "name" required>

            <label>Capacity:</label>
            <input type = "number" id = "capacity" required>

            <label>Level:</label>
            <select id = "level" required>
                <option value = "bronze">Bronze</option>
                <option value = "silver">Silver</option>
                <option value = "gold">Gold</option>
            </select>

            <label>Date:</label>
            <input type = "date" id = "date" required>

            <button type = "submit">Add Event</button>
        </form>
    </div>
</div>


<%###################################################
#                                                   #
#            Modal Pop-Up to Edit Event             #
#                                                   #
###################################################%>

<%# Calvin - Added modal pop-up for editing and deleting existing events %>
<div id = "editEventModal" class = "modal">
    <div class = "modal-content">

        <%# Edit Event Form Functionality %>
        <form id = "editEventForm">
            <input type = "hidden" id = "editEventId">

            <label>Event Name:</label>
            <input type = "text" id = "editName" required>

            <label>Capacity:</label>
            <input type = "number" id = "editCapacity" required>

            <label>Level:</label>
            <select id = "editLevel" required>
                <option value = "bronze">Bronze</option>
                <option value = "silver">Silver</option>
                <option value = "gold">Gold</option>
            </select>

            <label>Date:</label>
            <input type = "date" id = "editDate" required>

            <button type = "submit">Save Changes</button>


            <%# Delete Event Button Functionality %>
            <form id = "deleteEventForm">
                <input type = "hidden" id = "deleteEventId">
                <button type = "button">Delete Event</button>
            </form>
        </form>
    </div>
</div>


<%###################################################
#                                                   #
#            Delete Confirmation Modal              #
#                                                   #
###################################################%>

<%# Calvin - Added confirmation modal for deleting events %>
<div id = "deleteConfirmationModal" class = "modal">
    <div class = "modal-content">
        <input type = "hidden" id = "confirmDeleteEventId">

        <button id = "confirmDeleteButton" style = "background-color: red; color: white;">Yes, Delete</button>
        <button id = "cancelDeleteButton" type = "button">Cancel</button>
