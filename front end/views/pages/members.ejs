<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<header>
    
</header>



<body>
    <%- include('../partials/navbar'); %>
    <div class="row">
        <div class="col-9"></div>
        <div class="col-3">
            <button id="addMemberBtn" class="btn btn-primary">Add</button>
            <button id="tableDeleteBtn" class="btn btn-danger" style="display: none;">Delete</button>
        </div>
    </div>

    <div class="container">
        <table class="table table-hover">
            <!--sticky head goes here-->
            <thead>
                <tr>
                    <th scope="col"> </th>
                    <th scope="col">Name</th>
                    <th scope="col">Title</th>
                    <th scope="col">Level</th>
                    <th scope="col">Edit</th>
                </tr>
            </thead>
                <tbody class="table-group-divider">
                <% if (members && members.length > 0) { %>
                    <% members.forEach(function(memberStr) { 
                        let splitStr = memberStr.split(': ');
                        let id = splitStr[0];

                        let dataParts = splitStr[1].split(' | ');

                        let name = dataParts[0] ? dataParts[0].trim() : "";
                        let details = dataParts[1] ? dataParts[1].trim() : ""; 
                        let title = dataParts[2] ? dataParts[2].trim() : "";   
                        let level = dataParts[3] ? dataParts[3].trim() : "";   
                    %>
                        <tr>
                            <th scope="row">
                                <input class="form-check-input member-checkbox" type="checkbox" value="<%= id %>">
                            </th>
                            <td><%= name %></td>
                            <td><%= title %></td>
                            <td style="text-transform: capitalize;"><%= level %></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-light view-member-events-btn" title="View Registered Events" data-id="<%= id %>">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar-event" viewBox="0 0 16 16">
                                            <path d="M11 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5z"/>
                                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/>
                                        </svg>
                                    </button>
            
                                    <button type="button" class="btn btn-light edit-member-btn" data-id="<%= id %>" data-name="<%= name %>" data-details="<%= details %>" data-title="<%= title %>" data-level="<%= level %>">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center" style="padding: 20px;">No members found. Add a member to get started!</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <script src = "../../memberScript.js"></script>
</body>


<%###################################################
#                                                   #
#          Modal Pop-Up to Add New Member           #
#                                                   #
###################################################%>

<%# Calvin - Added modal pop-up for adding new members %>
<div id = "addMemberModal" class = "modal">
    <div class = "modal-content">
        <form id = "addMemberForm">
            <label>Member Name:</label>
            <input type = "text" id = "name" required>

            <label>Details:</label>
            <input type = "text" id = "details" required>

            <label>Title:</label>
            <input type = "text" id = "title" required>

            <label>Level:</label>
            <select id = "level" required>
                <option value = "bronze">Bronze</option>
                <option value = "silver">Silver</option>
                <option value = "gold">Gold</option>
            </select>

            <button type = "submit">Add Member</button>
            <button type = "button" id="cancelAddMemberBtn" class="btn btn-secondary" style="margin-left: 10px;">Cancel</button>
        </form>
    </div>
</div>


<%###################################################
#                                                   #
#           Modal Pop-Up to Edit Member             #
#                                                   #
###################################################%>

<%# Calvin - Added modal pop-up for editing and deleting existing members %>
<div id = "editMemberModal" class = "modal">
    <div class = "modal-content">

        <%# Edit Member Form Functionality %>
        <form id = "editMemberForm">
            <input type = "hidden" id = "editMemberId">

            <label>Member Name:</label>
            <input type = "text" id = "editName" required>

            <label>Details:</label>
            <input type = "text" id = "editDetails" required>

            <label>Title:</label>
            <input type = "text" id = "editTitle" required>

            <label>Level:</label>
            <select id = "editLevel" required>
                <option value = "bronze">Bronze</option>
                <option value = "silver">Silver</option>
                <option value = "gold">Gold</option>
            </select>

            <button type = "submit">Save Changes</button>
            <button type = "button" id="cancelEditMemberBtn" class="btn btn-secondary" style="margin-left: 10px;">Cancel</button>

            <%# Delete Member Button Functionality %>
            <form id = "deleteMemberForm">
                <input type = "hidden" id = "deleteMemberId">
                <button type = "button" class="btn btn-danger delete-member-btn">Delete Member</button>
            </form>
        </form>
    </div>
</div>


<%###################################################
#                                                   #
#            Delete Confirmation Modal              #
#                                                   #
###################################################%>

<%# Calvin - Added confirmation modal for deleting members %>
<div id = "deleteConfirmationModal" class = "modal">
    <div class = "modal-content">
        <input type = "hidden" id = "confirmDeleteMemberId">

        <button id = "confirmDeleteButton" style = "background-color: crimson; color: white;">Yes, Delete</button>
        <button id = "cancelDeleteButton" type = "button">Cancel</button>
    </div>
</div>


<%###################################################
#                                                   #
#  Modal Pop-Up to view Member's Event Registration #
#                                                   #
###################################################%>

<%# Calvin - Added modal pop-up to view member's event registrations %>
<div id="viewEventsModal" class="modal">
    <div class="modal-content" style="width: 65%;">
        <h3>Registered Events</h3>
        <hr>
        <table class="table">
            <thead>
                <tr>
                    <th>Event Name</th>
                    <th>Capacity</th>
                    <th>Level</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="memberEventsTableBody"></tbody>
        </table>
        <button type="button" id="closeViewEventsBtn" class="btn btn-secondary">Close</button>
    </div>
</div>