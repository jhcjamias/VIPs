<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<header>
    <%- include('../partials/navbar'); %>
</header>

<body>
    <div class="row">
        <div class="col-9"></div>
        <div class="col-3">
            <button id="addEventBtn" class="btn btn-primary">Add Event</button>
            <button id="tableDeleteBtn" class="btn btn-danger" style="display: none;">Delete</button>
        </div>
    </div>

    <div class="container">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col"> </th>
                    <th scope="col">Event Name</th>
                    <th scope="col">Capacity</th>
                    <th scope="col">Level</th>
                    <th scope="col">Date</th>
                    <th scope="col">Edit</th>
                </tr>
            </thead>

            <tbody class="table-group-divider">
                <% if (events && events.length > 0) { %>
                    <% events.forEach(function(eventStr) { 
                        let splitStr = eventStr.split(': ');
                        let id = splitStr[0];
                        let dataParts = splitStr[1].split(' | '); 
                        
                        let name = dataParts[0] ? dataParts[0].trim() : "";
                        let capacity = dataParts[1] ? dataParts[1].trim() : ""; // Max Capacity
                        let currentRegistered = dataParts[2] ? dataParts[2].trim() : "0"; // Current Capacity
                        let level = dataParts[3] ? dataParts[3].trim() : "";   
                        let date = dataParts[4] ? dataParts[4].trim() : "";   
                    %>
                        <tr>
                            <th scope="row">
                                <input class="form-check-input event-checkbox" type="checkbox" value="<%= id %>">
                            </th>
                            <td><%= name %></td>
                            
                            <td><%= currentRegistered %>/<%= capacity %></td>
                            
                            <td style="text-transform: capitalize;"><%= level %></td>
                            <td><%= date %></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-light view-event-members-btn" title="View Registered Members" data-id="<%= id %>">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
                                        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7Zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5.784 6A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216ZM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                                        </svg>
                                    </button>

                                    <button type="button" class="btn btn-light edit-event-btn" data-id="<%= id %>" data-name="<%= name %>" data-capacity="<%= capacity %>" data-level="<%= level %>" data-date="<%= date %>">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center" style="padding: 20px;">No events found. Add an event to get started!</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <script src = "../../eventScript.js"></script>
</body>




<%###################################################
#                                                   #
#           Modal Pop-Up to Add New Event           #
#                                                   #
###################################################%>

<%# Calvin - Added modal pop-up for adding new events %>
<div id = "addEventModal" class = "modal">
    <div class = "modal-content">
        <form id = "addEventForm">
            <label>Event Name:</label>
            <input type = "text" id = "name" required>

            <label>Max Capacity:</label>
            <input type = "number" id = "maxCapacity" required>

            <label>Level:</label>
            <select id = "level" required>
                <option value = "bronze">Bronze</option>
                <option value = "silver">Silver</option>
                <option value = "gold">Gold</option>
            </select>

            <label>Date:</label>
            <input type = "date" id = "date" required>

            <button type = "submit">Add Event</button>
        </form>
    </div>
</div>


<%###################################################
#                                                   #
#            Modal Pop-Up to Edit Event             #
#                                                   #
###################################################%>

<%# Calvin - Added modal pop-up for editing and deleting existing events %>
<div id = "editEventModal" class = "modal">
    <div class = "modal-content">

        <%# Edit Event Form Functionality %>
        <form id = "editEventForm">
            <input type = "hidden" id = "editEventId">

            <label>Event Name:</label>
            <input type = "text" id = "editName" required>

            <label>Max Capacity:</label>
            <input type = "number" id = "editMaxCapacity" required>

            <label>Level:</label>
            <select id = "editLevel" required>
                <option value = "bronze">Bronze</option>
                <option value = "silver">Silver</option>
                <option value = "gold">Gold</option>
            </select>

            <label>Date:</label>
            <input type = "date" id = "editDate" required>

            <button type = "submit">Save Changes</button>


            <%# Delete Event Button Functionality %>
            <button type="button" class="btn btn-danger delete-event-btn" style="margin-top:10px;">Delete Event</button>
        </form>
    </div>
</div>


<%###################################################
#                                                   #
#            Delete Confirmation Modal              #
#                                                   #
###################################################%>

<%# Calvin - Added confirmation modal for deleting events %>
<div id = "deleteConfirmationModal" class = "modal">
    <div class = "modal-content">

        <button id = "confirmDeleteButton" style = "background-color: crimson; color: white;">Yes, Delete</button>
        <button id = "cancelDeleteButton" type = "button">Cancel</button>
    </div>
</div>


<%###################################################
#                                                   #
#  Modal Pop-Up to view Members who've Registered   #
#                                                   #
###################################################%>

<div id="viewMembersModal" class="modal">
    <div class="modal-content" style="width: 65%;">
        <h3>Members Registered</h3>
        <hr>
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Title</th>
                    <th>Level</th>
                </tr>
            </thead>
            <tbody id="eventMembersTableBody"></tbody>
        </table>
        <button type="button" id="closeViewEventsBtn" class="btn btn-secondary">Close</button>
    </div>
</div>
</html>