
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>  
    <title>Register</title>
</head>

<header>
    <%- include('../partials/navbar'); %>    
</header>

<body>
    

    <div class="container">

        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-search me-2"></i>Searchable Dropdown</h5>
                <small class="text-muted">Type to filter &mdash; click or use arrow keys</small>
            </div>
        <div class="card-body">
            <div id="alertContainer"></div>
            <!-- ======== SEARCHABLE DROPDOWN MENU ========== -->
            <div class="mb-4">
                <label for="memberDropdown" class="form-label">Select a Member</label>                    <div class="searchable-dropdown" id="searchableDropdown">
                        <input
                        type="text"
                        class="form-control"
                        id="memberDropdown"
                        placeholder="Type to search members..."
                        autocomplete="off"
                        >
                        <span class="dropdown-toggle-icon">
                            <i class="bi bi-chevron-down"></i>
                        </span>
                        <ul class="dropdown-menu" id="memberMenu"></ul>
                    </div>
                    <div class="selected-display" id="selectedDisplay">
                        Selected: <strong>None</strong>
                    </div>
                </div>
                <!-- ================================================ -->

                <!-- SEARCHABLE DOWNDROP FOR EVENTS -->
                <div class="mb-0">
                    <label for="eventDropdown" class="form-label">Select an Event</label>
                    <div class="searchable-dropdown" id="eventDropdownWrapper">
                        <input
                        type="text"
                        class="form-control"
                        id="eventDropdown"
                        placeholder="Search events..."
                        autocomplete="off"
                        >
                        <span class="dropdown-toggle-icon">
                            <i class="bi bi-chevron-down"></i>
                        </span>
                        <ul class="dropdown-menu" id="eventMenu"></ul>
                    </div>
                    <div class="selected-display" id="eventSelectedDisplay">
                        Selected: <strong>None</strong>
                    </div>
                </div>
                <div class="d-flex justify-content-end pt-4 pb-2">
                    <button id="reg" type="button" class="btn btn-primary">Register</button>
                </div>

            </div>
        </div>
    </div>

    <script id="registration-data" type="application/json">
        <%- JSON.stringify({ members: members, events: events }) %>
    </script>
    <script src="../../regScript.js"></script>

</body>


</html> 