
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
    <style>

        /* Main content wrapper fills remaining height and centers the card */
        .container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            width: 100%;
            max-width: 420px;
        }

        .card-header {
            background: #fff;
            border-bottom: 1px solid #eef0f3;
            border-radius: 16px 16px 0 0 !important;
            padding: 1.25rem 1.5rem;
        }

        .card-header h5 {
            margin: 0;
            font-weight: 600;
            color: #1a1d23;
        }

        .card-body {
            padding: 1.5rem;
        } 

        /* ---------- Searchable Dropdown Wrapper ---------- */
        .searchable-dropdown {
            position: relative;
        }

        .searchable-dropdown .form-control {
            padding-right: 2.5rem;
            border-radius: 10px;
            border: 1.5px solid #dee2e6;
            font-size: 0.95rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
            caret-color: #0d6efd;
        }

        .searchable-dropdown .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
        }

        /* Chevron icon inside the input */
        .searchable-dropdown .dropdown-toggle-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            color: #6c757d;
            font-size: 0.8rem;
            transition: transform 0.25s ease;
        }

        .searchable-dropdown.open .dropdown-toggle-icon {
            transform: translateY(-50%) rotate(180deg);
        }

        /* The dropdown menu */
        .searchable-dropdown .dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            margin-top: 6px;
            padding: 6px 0;
            border: 1.5px solid #e9ecef;
            border-radius: 10px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.1);
            max-height: 260px;
            overflow-y: auto;
            z-index: 1000;
            background: #fff;
            list-style: none;
        }

        .searchable-dropdown .dropdown-menu.show {
            display: block;
        }

        .searchable-dropdown .dropdown-item {
            padding: 10px 16px;
            font-size: 0.93rem;
            color: #212529;
            cursor: pointer;
            transition: background 0.15s ease, color 0.15s ease;
            border-radius: 0;
        }

        .searchable-dropdown .dropdown-item:hover {
            background: #f0f4ff;
            color: #0d6efd;
        }

        .searchable-dropdown .dropdown-item.selected {
            background: #e8f0fe;
            color: #0d6efd;
            font-weight: 500;
        }

        .searchable-dropdown .dropdown-item.no-results {
            color: #999;
            font-style: italic;
            cursor: default;
            pointer-events: none;
        }

        /* Scrollbar styling */
        .searchable-dropdown .dropdown-menu::-webkit-scrollbar {
            width: 5px;
        }

        .searchable-dropdown .dropdown-menu::-webkit-scrollbar-track {
            background: transparent;
        }

        .searchable-dropdown .dropdown-menu::-webkit-scrollbar-thumb {
            background: #d4d9df;
            border-radius: 10px;
        }

        /* Label */
        .form-label {
            font-weight: 500;
            color: #374151;
            margin-bottom: 0.5rem;
            font-size: 0.95rem;
        }

        /* Selected value display */
        .selected-display {
            margin-top: 0.75rem;
            font-size: 0.85rem;
            color: #6b7280;
        }
        .selected-display strong {
            color: #0d6efd;
        }
    </style>    
</head>

<header>
    <%- include('../partials/navbar'); %>    
</header>

<body>

    <div class="container">

        <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-search me-2"></i>Searchable Dropdown</h5>
            <small class="text-muted">Type to filter &mdash; click or use arrow keys</small>
        </div>
        <div class="card-body">

            <!-- ============ THE SEARCHABLE DROPDOWN ============ -->
            <div class="mb-3">
                <label for="countryDropdown" class="form-label">Select a Country</label>
                <div class="searchable-dropdown" id="searchableDropdown">
                    <input
                    type="text"
                    class="form-control"
                    id="countryDropdown"
                    placeholder="Type to search..."
                    autocomplete="off"
                    >
                    <span class="dropdown-toggle-icon">
                        <i class="bi bi-chevron-down"></i>
                    </span>
                    <ul class="dropdown-menu" id="dropdownMenu"></ul>
                </div>
                <div class="selected-display" id="selectedDisplay">
                    Selected: <strong>None</strong>
                </div>
            </div>
            <!-- ================================================ -->

            <!-- Another example: fruit picker -->
            <div class="mb-0">
                <label for="fruitDropdown" class="form-label">Pick a Fruit</label>
                <div class="searchable-dropdown" id="fruitDropdownWrapper">
                    <input
                    type="text"
                    class="form-control"
                    id="fruitDropdown"
                    placeholder="Search fruits..."
                    autocomplete="off"
                    >
                    <span class="dropdown-toggle-icon">
                        <i class="bi bi-chevron-down"></i>
                    </span>
                    <ul class="dropdown-menu" id="fruitMenu"></ul>
                </div>
                <div class="selected-display" id="fruitSelectedDisplay">
                    Selected: <strong>None</strong>
                </div>
            </div>

        </div>
        </div>
    </div>

    <script src="../../regScript.js"></script>

</body>


</html> 