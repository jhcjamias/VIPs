<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<style>
    header {
        padding: 2.0rem 4.0rem;
    }
    body {
        padding: 2.0rem 4.0rem;
    }

    .modal {
        display: none; /*Hidden by default*/
        position: fixed;
        z-index: 1050; /* Increased from 1000 to beat the sticky-top navbar */
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5); 
        backdrop-filter: blur(4px); 
    }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 25px;
        border: none;
        width: 50%;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .modal-content label {
        display: block;
        margin-top: 15px;
        font-weight: 600;
        color: #333;
    }

    .modal-content input, .modal-content select {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: 1px solid lightgray;
        border-radius: 6px;
        box-sizing: border-box;
    }

    .modal-content button {
        margin-top: 20px;
        padding: 10px 20px;
        border-radius: 5px;
        border: none;
        cursor: pointer;
        font-weight: bold;
    }

    .btn-danger {
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
    }

    button[type='submit'] {background-color: royalblue; color: white;}
    .delete-member-btn { background-color: crimson; color: white; margin-left: 10px;}
    #cancelDeleteButton { background-color: lightslategray; color: white;}

    #deleteConfirmationModal {
        z-index: 2000; /* Ensures delete confirmation modal appears above all other modals */
    }
        /* Main content wrapper fills remaining height and centers the card */
    .container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }
    
    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        width: 100%;
        max-width: 420px;
    }

    .card-header {
        background: #fff;
        border-bottom: 1px solid #eef0f3;
        border-radius: 16px 16px 0 0 !important;
        padding: 1.25rem 1.5rem;
    }

    .card-header h5 {
        margin: 0;
        font-weight: 600;
        color: #1a1d23;
    }

    .card-body {
        padding: 1.5rem;
    } 

    /* ---------- Searchable Dropdown Wrapper ---------- */
    .searchable-dropdown {
        position: relative;
    }

    .searchable-dropdown .form-control {
        padding-right: 2.5rem;
        border-radius: 10px;
        border: 1.5px solid #dee2e6;
        font-size: 0.95rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        caret-color: #0d6efd;
    }

    .searchable-dropdown .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
    }

    /* Chevron icon inside the input */
    .searchable-dropdown .dropdown-toggle-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        color: #6c757d;
        font-size: 0.8rem;
        transition: transform 0.25s ease;
    }

    .searchable-dropdown.open .dropdown-toggle-icon {
        transform: translateY(-50%) rotate(180deg);
    }

    /* The dropdown menu */
    .searchable-dropdown .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        margin-top: 6px;
        padding: 6px 0;
        border: 1.5px solid #e9ecef;
        border-radius: 10px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.1);
        max-height: 260px;
        overflow-y: auto;
        z-index: 1000;
        background: #fff;
        list-style: none;
    }

    .searchable-dropdown .dropdown-menu.show {
        display: block;
    }

    .searchable-dropdown .dropdown-item {
        padding: 10px 16px;
        font-size: 0.93rem;
        color: #212529;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
        border-radius: 0;
    }

    .searchable-dropdown .dropdown-item:hover {
        background: #f0f4ff;
        color: #0d6efd;
    }

    .searchable-dropdown .dropdown-item.selected {
        background: #e8f0fe;
        color: #0d6efd;
        font-weight: 500;
    }

    .searchable-dropdown .dropdown-item.no-results {
        color: #999;
        font-style: italic;
        cursor: default;
        pointer-events: none;
    }

    /* Scrollbar styling */
    .searchable-dropdown .dropdown-menu::-webkit-scrollbar {
        width: 5px;
    }

    .searchable-dropdown .dropdown-menu::-webkit-scrollbar-track {
        background: transparent;
    }

    .searchable-dropdown .dropdown-menu::-webkit-scrollbar-thumb {
        background: #d4d9df;
        border-radius: 10px;
    }

    /* Label */
    .form-label {
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    /* Selected value display */
    .selected-display {
        margin-top: 0.75rem;
        font-size: 0.85rem;
        color: #6b7280;
    }
    .selected-display strong {
        color: #0d6efd;
    }

</style>