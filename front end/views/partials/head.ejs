<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

<style>
    header {
        padding: 2.0rem 4.0rem;
    }
    body {
        padding: 2.0rem 4.0rem;
    }

    .modal {
        display: none; /*Hidden by default*/
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5); /*Greys out background to give more focus to modal popup*/
        backdrop-filter: blur(4px); /*Blur effect*/
    }

    .modal-content {
        background-color: #fefefe;
        margin: 15% auto;
        padding: 25px;
        border: none;
        width: 50%;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .modal-content label {
        display: block;
        margin-top: 15px;
        font-weight: 600;
        color: #333;
    }

    .modal-content input, .modal-content select {
        width: 100%;
        padding: 10px;
        margin-top: 5px;
        border: 1px solid lightgray;
        border-radius: 6px;
        box-sizing: border-box;
    }

    .modal-content button {
        margin-top: 20px;
        padding: 10px 20px;
        border-radius: 5px;
        border: none;
        cursor: pointer;
        font-weight: bold;
    }

    .btn-danger {
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
    }

    button[type='submit'] {background-color: royalblue; color: white;}
    .delete-member-btn { background-color: crimson; color: white; margin-left: 10px;}
    #cancelDeleteButton { background-color: lightslategray; color: white;}

    #deleteConfirmationModal {
        z-index: 2000; /* Ensures delete confirmation modal appears above all other modals */
    }
</style>