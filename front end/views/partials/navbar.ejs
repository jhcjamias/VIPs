<nav class="navbar sticky-top navbar-expand-lg navbar-light bg-light">
  <a class="navbar-brand" href="/">VIPs</a>
  
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  
  <div class="collapse navbar-collapse" id="navbarNav">
    <ul class="navbar-nav">
      <li class="nav-item" id="nav-members">
        <a class="nav-link" href="/members">Members</a>
      </li>
      <li class="nav-item" id="nav-events">
        <a class="nav-link" href="/events">Events</a>
      </li>
      <li class="nav-item" id="nav-register">
        <a class="nav-link" href="/register">Register</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const currentPath = window.location.pathname;

    // Map your paths to the corresponding nav item IDs
    const navMap = {
      '/members': 'nav-members',
      '/events': 'nav-events',
      '/register': 'nav-register'
    };

    // Find the matching ID for the current path
    const activeNavId = navMap[currentPath];
    
    // If a match is found, add the 'active' class
    if (activeNavId) {
      const activeElement = document.getElementById(activeNavId);
      if (activeElement) {
        activeElement.classList.add('active');
      }
    }
  });
</script>